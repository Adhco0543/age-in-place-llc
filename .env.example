# Server-only: add these to the hosting project's environment variables.
RESEND_API_KEY=
# A sending address on a domain verified in Resend (no display name here).
CONTACT_FROM_EMAIL=
# Optional. Defaults to the business email in src/lib/config.ts.
CONTACT_TO_EMAIL=Adh@Wbhb666.com

# Optional: Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=

# Optional: the genuine "Ask for reviews" link from the business's Google profile.
# Shown to all visitors independently of the feedback form and selected rating.
GOOGLE_REVIEW_URL=
